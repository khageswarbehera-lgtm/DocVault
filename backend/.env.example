# Hosting platforms provide PORT; defaults to 5000 for local development.
PORT=5000
# Set to production in the deployed backend environment.
NODE_ENV=development
DNS_SERVERS=
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

MAX_FILE_SIZE_MB=25

CLIENT_URL=http://localhost:5173